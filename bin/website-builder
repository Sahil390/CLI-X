#!/usr/bin/env node
// Production bin: runs compiled dist/cli.js, no ts-node required at runtime
import { createRequire } from 'module';
import { fileURLToPath } from 'url';
import path from 'path';
const __dirname = path.dirname(fileURLToPath(import.meta.url));
try {
  await import(path.resolve(__dirname, '../cli/dist/cli.js'));
} catch (e) {
  process.stderr.write(`website-builder: failed to start — ${e.message}\n`);
  process.stderr.write('  Fix: rebuild with "npm run build" then retry.\n');
  process.exit(1);
}
